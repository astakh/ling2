# PostgreSQL (удалённый сервер)
# Формат: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://lingoflow:your_password@your-server-ip:5432/lingoflow

# Безопасность
SECRET_KEY=change-this-to-random-string-in-production

# JWT токены
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GigaChat API (для генерации предложений и проверки переводов)
# Документация: https://developers.sber.ru/docs/ru/gigachat/api/reference/rest/post-token
# Получить credentials: https://developers.sber.ru/studio/workspaces
# Формат: Basic <base64-encoded-client-credentials>
GIGACHAT_CREDENTIALS=your-gigachat-credentials-here
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://api.giga.chat/v1
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Spaced repetition parameters
# Максимальное количество уроков (максимальный stage)
MAX_LESSONS=100
# Количество слов в уроке (по умолчанию)
WORDS_PER_LESSON=5
# Интервалы повторения в уроках (через запятую)
REPETITION_INTERVALS=1,2,4,7,14,21,30,45,60,90

# Admin panel password
ADMIN_PASSWORD=admin123
