# PostgreSQL (удалённый сервер)
# Формат: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://lingoflow:your_password@your-server-ip:5432/lingoflow

# Безопасность
SECRET_KEY=change-this-to-random-string-in-production

# JWT токены
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI API (для генерации предложений и проверки переводов)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
